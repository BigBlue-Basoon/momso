{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "momso",
  "version": "0.1.1",
  "identifier": "app.momso.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "momso",
        "decorations": false,
        "backgroundColor": "#f8f9f7",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 660,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNUIxNjQ1ODVDMjU5NzcKUldSM1djS0ZSUlpidWlBd2JRdzNhb2xPanFra2hkMS9wMDk2NXFvdW5PR2VHL2NtM1lseEZhS00K",
      "endpoints": ["https://github.com/BigBlue-Basoon/momso/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "generated/node/": "node/", "../third-party/": "third-party/" },
    "publisher": "MOW · BigBlue",
    "category": "Productivity",
    "shortDescription": "요가 수업 기록을 로컬에 보존하는 momso Windows 알파",
    "longDescription": "momso는 요가 수업의 원본과 강사 검수 기록을 사용자 컴퓨터에 보존하는 로컬 중심 데스크톱 도구입니다.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

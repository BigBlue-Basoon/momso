{
  "name": "momso-desktop-workspace",
  "private": true,
  "workspaces": ["apps/alpha/desktop"],
  "scripts": {
    "desktop:dev": "npm run tauri dev --workspace @momso/alpha-desktop",
    "desktop:ui": "npm run dev --workspace @momso/alpha-desktop",
    "desktop:build": "npm run tauri build --workspace @momso/alpha-desktop",
    "desktop:ui:build": "npm run build --workspace @momso/alpha-desktop",
    "desktop:version:check": "node scripts/check-desktop-version.mjs",
    "desktop:artifact:metadata": "node scripts/create-desktop-artifact-metadata.mjs",
    "desktop:artifact:metadata:test": "node --test scripts/create-desktop-artifact-metadata.test.mjs"
  }
}
